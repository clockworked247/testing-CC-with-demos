# Currency Trading Analysis Platform - Environment Configuration

# ===== LLM Configuration =====
# OpenRouter API Key (Required for AI analysis features)
# Get your key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# LLM Model (Optional - defaults to claude-3.5-sonnet)
# Options: anthropic/claude-3.5-sonnet, openai/gpt-4, google/gemini-pro, etc.
LLM_MODEL=anthropic/claude-3.5-sonnet

# ===== Database Configuration =====
# Database URL (Optional - defaults to SQLite)
DATABASE_URL=sqlite:///./data/trading.db
# For PostgreSQL: postgresql://user:password@localhost/trading_db
# For MySQL: mysql://user:password@localhost/trading_db

# ===== News Configuration =====
# News API Key (Optional - for enhanced news features)
# Get your key from: https://newsapi.org
NEWS_API_KEY=your_news_api_key_here

# ===== Email Notifications (SMTP) =====
# For Gmail: Use App Password (not your regular password)
# Enable 2FA, then create App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_EMAIL=your_email@gmail.com

# For other providers:
# Outlook: smtp-mail.outlook.com (port 587)
# Yahoo: smtp.mail.yahoo.com (port 587)
# SendGrid: smtp.sendgrid.net (port 587)

# ===== SMS Notifications (Twilio) =====
# Get credentials from: https://www.twilio.com/console
# Free trial includes $15 credit (enough for ~500 SMS)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_PHONE=+1234567890

# ===== Notification Scheduler =====
# How often to check for trading opportunities
# Options: "hourly" or "daily"
NOTIFICATION_CHECK_INTERVAL=daily

# For daily checks, what time to run (24-hour format)
# Default: 09:00 (9 AM)
NOTIFICATION_CHECK_TIME=09:00
