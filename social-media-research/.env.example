# Apify API Configuration
# Get your API key from https://console.apify.com/account/integrations
APIFY_API_KEY=your_apify_api_key_here

# OpenRouter API Configuration
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# LLM Model Configuration (optional)
# Default: anthropic/claude-3.5-sonnet
# Other options: anthropic/claude-3-opus, openai/gpt-4, etc.
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Scraping Configuration (optional)
MAX_VIDEOS_PER_SEARCH=50
INCLUDE_VIDEO_FILES=false

# Output Configuration (optional)
OUTPUT_DIR=output
