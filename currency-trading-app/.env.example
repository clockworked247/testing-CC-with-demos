# Currency Trading Analysis Platform - Environment Configuration

# OpenRouter API Key (Required for LLM features)
# Get your key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# LLM Model (Optional - defaults to claude-3.5-sonnet)
# Options: anthropic/claude-3.5-sonnet, openai/gpt-4, google/gemini-pro, etc.
LLM_MODEL=anthropic/claude-3.5-sonnet

# Database URL (Optional - defaults to SQLite)
DATABASE_URL=sqlite:///./data/trading.db
# For PostgreSQL: postgresql://user:password@localhost/trading_db
# For MySQL: mysql://user:password@localhost/trading_db

# News API Key (Optional - for enhanced news features)
# Get your key from: https://newsapi.org
NEWS_API_KEY=your_news_api_key_here
